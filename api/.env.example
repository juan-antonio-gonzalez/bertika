PORT=3001
# PostgreSQL (URL SIN comillas)
DATABASE_URL=postgres://bertika:TU_CONTRASENA@localhost:5432/bertika
# Secreto JWT (openssl rand -hex 32)
JWT_SECRET=TU_SECRETO_JWT
# Dominios permitidos en CORS (comma separados)
ALLOWED_ORIGINS=https://bertika.com,https://www.bertika.com
# Ruta absoluta donde se montan las fotos /uploads (sin barra final)
UPLOAD_DIR=/var/www/bertika/uploads
# Ruta de acceso público a /uploads
PUBLIC_URL=https://bertika.com
# Contraseñas de las cuentas de acceso (NO versionar valores; ver local/credenciales-demo.txt)
# Minimo 8 caracteres. Mismo formato que en /etc/bertika/bertika-api.env del VPS.
DEMO_ADMIN_PASS=xxxx
DEMO_TEC01_PASS=xxxx
DEMO_CLI01_PASS=xxxx
# Habilita POST /api/reset (borra TODO y re-siembra los datos de demo).
# En produccion dejarlo VACIO/sin definir. Nunca activarlo en produccion sin respaldo.
ALLOW_RESET=
# Correo: consultas del formulario de contacto del sitio
# Destinatario de las consultas (por defecto ventas@bertika.com)
MAIL_TO=ventas@bertika.com
# Remitente (por defecto igual a MAIL_USER)
MAIL_FROM=admin@bertika.com
# SMTP de la casilla (ej. Hostinger: smtp.hostinger.com / 465 / true)
MAIL_HOST=smtp.hostinger.com
MAIL_PORT=465
MAIL_SECURE=true
MAIL_USER=admin@bertika.com
MAIL_PASS=TU_CONTRASENA_DEL_BUZON
# ---------- WhatsApp (Meta Cloud API) ----------
# Guía paso a paso: docs/WHATSAPP_META.md
# Cargar con: bash scripts/whatsapp-env.sh (no tipear los valores a mano acá).
# Ese script termina llamando a scripts/whatsapp-activar.sh, que suscribe la
# cuenta y configura el webhook por API. No son secretos, pero se centralizan acá.
# App ID de Meta (el número que aparece en developers.facebook.com/apps/<id>/)
WHATSAPP_APP_ID=
# Business ID de Meta (el del panel de negocio)
WHATSAPP_BUSINESS_ID=
# Token de la app (permanente, de un Usuario del sistema de Meta Business)
WHATSAPP_TOKEN=
# Phone number ID del número que envía (si queda vacío, se descubre por API)
WHATSAPP_PHONE_ID=
# WhatsApp Business Account ID (si queda vacío, se descubre por API)
WHATSAPP_WABA_ID=
# Frase secreta que inventás (o se genera sola) para verificar el webhook
WHATSAPP_VERIFY_TOKEN=
# App Secret (Configuración de la app → Básica): valida la firma de los avisos
WHATSAPP_APP_SECRET=
# Versión de la Graph API (opcional, por defecto v22.0)
WHATSAPP_API_VERSION=
